<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            xmlns="http://javafx.com/javafx"
            fx:controller="co.id.controller.pages.EmployeeController"
            styleClass="list-menu-background">
                           
    <top>
        <VBox spacing="10" styleClass="list-menu-top-vbox">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Employee" styleClass="list-menu-top-label"/>
                <TextField fx:id="searchField" promptText="Search..." />
                <Button fx:id="filterBtn" text="Filter">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16" >
                            <image>
                                <Image url="@/icons/loupe.png"/>
                            </image>
                        </ImageView>                    
                    </graphic>
                </Button>
                <Button fx:id="refreshBtn" text="Refresh">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16" >
                            <image>
                                <Image url="@/icons/refresh.png"/>
                            </image>
                        </ImageView>                    
                    </graphic>
                </Button>
                <HBox HBox.hgrow="ALWAYS"/>
                <Button fx:id="addBtn" text="Add" styleClass="list-menu-top-button">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16" >
                            <image>
                                <Image url="@/icons/printer.png"/>
                            </image>
                        </ImageView>                    
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </top>
    
    <center>
        <VBox spacing="10" styleClass="list-menu-center-vbox">
            <TableView fx:id="tableView" prefHeight="400">
                <columns>
                    <TableColumn fx:id="tableColumnAction" text="Action" prefWidth="200"/>
                    <TableColumn fx:id="tableColumnCode" text="Employee Code" prefWidth="150"/>
                    <TableColumn fx:id="tableColumnName" text="Name" prefWidth="150"/>
                    <TableColumn fx:id="tableColumnAddress" text="Address" prefWidth="150"/>
                    <TableColumn fx:id="tableColumnPhone" text="Phone" prefWidth="150"/>
                    <TableColumn fx:id="tableColumnEmail" text="Email" prefWidth="150"/>
                    <TableColumn fx:id="tableColumnGender" text="Gender" prefWidth="150"/>
                    <TableColumn fx:id="tableColumnDateHired" text="Date Hired" prefWidth="150"/>
                    <TableColumn fx:id="tableColumnStatus" text="Status" prefWidth="150"/>
                    <TableColumn fx:id="tableColumnDateStart" text="Date Start" prefWidth="150"/>
                    <TableColumn fx:id="tableColumnDateEnd" text="DateEnd" prefWidth="150"/>
                    <TableColumn fx:id="tableColumnContract" text="Contract" prefWidth="150"/>
                    <TableColumn fx:id="tableColumnDepartment" text="Department" prefWidth="150"/>
                    <TableColumn fx:id="tableColumnPosition" text="Position" prefWidth="150"/>
                    <TableColumn fx:id="tableColumnDateCreated" text="Date Created" prefWidth="150"/>
                    <TableColumn fx:id="tableColumnDateUpdated" text="Date Updated" prefWidth="150"/>
                    <TableColumn fx:id="tableColumnCreatedBy" text="CreatedBy" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>
    </center>
    
    <bottom>
        <VBox spacing="10" alignment="CENTER" styleClass="list-menu-bottom-vbox">
            <Pagination fx:id="pagination" pageCount="10" maxPageIndicatorCount="5"/>
        </VBox>
    </bottom>
</BorderPane>
