<?xml version="1.0" encoding="UTF-8"?>
<?import co.id.component.*?>
<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.collections.FXCollections?>

<VBox xmlns:fx="http://javafx.com/fxml"
      xmlns="http://javafx.com/javafx"
      fx:controller="co.id.controller.pages.UserFormController"
      spacing="15" styleClass="form-background">
      
    <Label text="Form User" styleClass="form-label"/>
    
    <VBox spacing="10">
        <TextField fx:id="textFieldUsername" promptText="Username"/>
        <PasswordToggleField fx:id="passwordFieldPassword"/>
        <TextField fx:id="textFieldFullName" promptText="Full Name"/>
        
        <ComboBox fx:id="comboRole" promptText="Role">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="ADMIN"/>
                    <String fx:value="STAFF"/>
                </FXCollections>
            </items>
        </ComboBox>
        
        <LookupBox fx:id="lookupBoxEmployee" promptText="Link to Employee (optional)"/>
    </VBox>
    
    <VBox styleClass="form-vbox"/>
    <HBox alignment="CENTER_RIGHT">
        <Button text="Save" fx:id="saveBtn" onAction="#saveEntity" styleClass="form-button">
            <graphic>
                <ImageView fitHeight="16" fitWidth="16">
                    <image>
                        <Image url="@/icons/save.png"/>
                    </image>
                </ImageView>                    
            </graphic>
        </Button>   
    </HBox>
</VBox>