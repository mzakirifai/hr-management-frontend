<VBox xmlns="http://javafx.com/javafx" 
      xmlns:fx="http://javafx.com/fxml" 
      fx:controller="co.id.controller.pages.HelpController"
      spacing="10" styleClass="form-background">
    
    <Label text="User Guide" styleClass="form-label"/>
    <Separator/> 
    
    <Label text="Master" styleClass="section-title"/>
